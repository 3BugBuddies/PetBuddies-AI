GEMINI_API_KEY=
# Banco local do docker-compose. Para o Oracle da FIAP, troque host e service
# name — o service name da imagem oracle-free e FREEPDB1, nao ORCL.
ORACLE_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
# MAIUSCULO de proposito: o Oracle guarda nomes de schema em maiusculas, e o
# default_schema do Hibernate usa este valor literal. Em minusculas, o schema
# "petbuddies" nao existe e a aplicacao nao sobe.
ORACLE_USER=PETBUDDIES
ORACLE_PASSWORD=petbuddies
# Senha do SYS do container; so o compose usa.
ORACLE_SYS_PASSWORD=oracle

# Segredo do JWT (ADR s3-20) — HS256, minimo 32 bytes.
# O MESMO valor byte a byte no .NET; nunca versionado.
PETBUDDIES_JWT_SECRET=
# Porta do Oracle no host. Duas worktrees ao mesmo tempo precisam de portas
# diferentes; use tambem COMPOSE_PROJECT_NAME proprio em cada uma.
ORACLE_PORT=1521
